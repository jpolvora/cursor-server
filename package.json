{
  "name": "cursor-server",
  "version": "0.1.0",
  "description": "API server for delegating Cursor agent tasks against local repository workspaces",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "scan-secrets": "node scripts/scan-secrets.mjs",
    "deploy:pages": "node scripts/build-pages-site.mjs",
    "test:pages": "npm run deploy:pages && node scripts/verify-pages-site.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.23",
    "@hono/node-server": "^2.0.12",
    "hono": "^4.7.10",
    "node-cron": "^3.0.3",
    "sql.js": "^1.14.1",
    "ws": "^8.21.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/node-cron": "^3.0.11",
    "@types/sql.js": "^1.4.11",
    "@types/ws": "^8.18.1",
    "husky": "^9.1.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
