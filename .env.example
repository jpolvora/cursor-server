# Required: Cursor API key (user or team service account)
# https://cursor.com/dashboard/cloud-agents
CURSOR_API_KEY=cursor_...

# OpenCode Go API key (agentic-code-reviewers: engine=opencode)
# https://opencode.ai — also used by GitHub Actions secret OPENCODE_API_KEY
OPENCODE_API_KEY=

# Minimum score (0-10) to post review threads (default 6; matches code-review.yml)
AGENTIC_CODE_REVIEWERS_SCORE_MIN=4

# Server
PORT=3000
# Bind all interfaces so Tailscale/LAN clients can reach the API.
# Use 127.0.0.1 only for localhost-only access (blocks remote clients).
HOST=0.0.0.0

# Root directory containing cloned repositories the server can operate on.
# Bare-metal / npm: default REPOS_ROOT=./repos (relative to process cwd).
# Docker Compose: set REPOS_ROOT=/data/repos via compose environment (volume mount); do not rely on this file alone in containers.
REPOS_ROOT=./repos

# Default model for local agent runs
CURSOR_MODEL=composer-2

# Multi-tenant resource limits (optional; per-tenant overrides in TENANTS JSON)
# TENANT_CPU_LIMIT=0.5
# TENANT_MEMORY_LIMIT_MB=512
# TENANTS=[{"id":"tenant-a","apiKey":"...","allowedRepos":["repo-a"],"cpuLimit":1,"memoryLimitMb":1024}]
