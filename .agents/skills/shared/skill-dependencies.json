{
  "version": 1,
  "packageVersion": "0.0.85",
  "upstream": {
    "repo": "jpolvora/workflow-skills",
    "url": "https://github.com/jpolvora/workflow-skills",
    "note": "Managed skills ship from this upstream. Lasting improvements must be submitted as PRs there; consumer copies are overwritten on update."
  },
  "hub": {
    "dir": "shared",
    "ensureWhen": [
      "full",
      "workflows",
      "workflow-skill-selected"
    ]
  },
  "packages": {
    "full": {
      "select": "all-skills",
      "ensureHub": true,
      "shortcut": "f",
      "label": "Full package"
    },
    "workflows": {
      "skills": [
        "spec-to-pr",
        "spec-to-pr-lite",
        "ws-write-spec",
        "ws-write-plan",
        "ws-interview",
        "ws-plan-to-tasks",
        "ws-implement-tasks",
        "ws-verify-plan",
        "ws-code-review",
        "ws-testing",
        "ws-ship-pr",
        "ws-fix-pr",
        "ws-goal-fix-pr",
        "ws-update-plan-implementation",
        "github-provider",
        "azure-devops-provider",
        "local-spec-provider",
        "check-harness",
        "check-workflows",
        "caveman",
        "gabarito",
        "karpathy-guidelines",
        "spec-format",
        "goal-loop",
        "self-learning",
        "changelog",
        "secrets-leak-review",
        "configure-project",
        "fable-method",
        "fable-judge",
        "fable-domain",
        "ws-multi-spec"
      ],
      "ensureHub": true,
      "shortcut": "w",
      "label": "Workflows package"
    },
    "extra": {
      "skills": [
        "write-a-skill",
        "show-harness"
      ],
      "ensureHub": false,
      "shortcut": "e",
      "label": "Extra package"
    }
  },
  "dependencies": {
    "spec-to-pr": [
      "ws-write-spec",
      "ws-write-plan",
      "ws-interview",
      "ws-plan-to-tasks",
      "ws-implement-tasks",
      "ws-verify-plan",
      "ws-code-review",
      "ws-testing",
      "ws-ship-pr",
      "ws-fix-pr",
      "ws-goal-fix-pr",
      "ws-update-plan-implementation",
      "github-provider",
      "azure-devops-provider",
      "local-spec-provider",
      "check-harness",
      "check-workflows",
      "caveman",
      "gabarito",
      "karpathy-guidelines",
      "spec-format",
      "goal-loop",
      "self-learning",
      "changelog",
      "configure-project"
    ],
    "spec-to-pr-lite": [
      "ws-write-spec",
      "ws-write-plan",
      "ws-implement-tasks",
      "ws-code-review",
      "ws-ship-pr",
      "ws-fix-pr",
      "ws-goal-fix-pr",
      "github-provider",
      "azure-devops-provider",
      "local-spec-provider",
      "caveman",
      "gabarito",
      "karpathy-guidelines",
      "spec-format",
      "self-learning",
      "changelog",
      "configure-project"
    ],
    "ws-write-spec": [
      "spec-format"
    ],
    "github-provider": [
      "spec-format"
    ],
    "azure-devops-provider": [
      "spec-format"
    ],
    "local-spec-provider": [
      "spec-format"
    ],
    "ws-goal-fix-pr": [
      "ws-fix-pr",
      "goal-loop"
    ],
    "ws-write-plan": [
      "fable-domain"
    ],
    "ws-verify-plan": [
      "fable-judge"
    ],
    "ws-ship-pr": [
      "secrets-leak-review",
      "fable-judge"
    ],
    "ws-code-review": [
      "karpathy-guidelines",
      "caveman",
      "gabarito",
      "self-learning",
      "fable-judge"
    ],
    "fable-method": [
      "fable-judge",
      "fable-domain",
      "caveman",
      "gabarito",
      "karpathy-guidelines",
      "self-learning"
    ],
    "fable-judge": [
      "caveman",
      "gabarito",
      "karpathy-guidelines"
    ],
    "ws-multi-spec": [
      "spec-to-pr",
      "spec-to-pr-lite",
      "caveman",
      "gabarito",
      "karpathy-guidelines"
    ]
  },
  "autoloadOnly": [],
  "selectOffRule": "no-cascade-deselect"
}
